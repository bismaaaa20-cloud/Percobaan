-- [[ BISMA HUB V10 - SCRIPT EXECUTION ]] --
local BismaLib = loadstring(game:HttpGet("https://githubusercontent.com"))()
local Window = BismaLib:CreateWindow("BISMA HUB V10")

local Settings = {AFK = false, Clear = false, Aura = false, AutoH = false, Range = 3000}

-- Tambahkan Tombol Sesuai Kebutuhan
Window:AddToggle("AFK Sky Circle (Naik 30)", function(v) Settings.AFK = v end)
Window:AddToggle("Instant Clear Wave (Nuke)", function(v) Settings.Clear = v end)
Window:AddToggle("Global Kill Aura", function(v) Settings.Aura = v end)
Window:AddToggle("Auto Buy Health (Hijau)", function(v) Settings.AutoH = v end)

-- Logika Engine Utama
task.spawn(function()
    local counter, centerPos = 0, nil
    while task.wait(0.05) do
        local p = game.Players.LocalPlayer
        local char = p.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            -- Fitur AFK (Naik 30 Blok & Putar)
            if Settings.AFK then
                if not centerPos then centerPos = char.HumanoidRootPart.Position + Vector3.new(0, 30, 0) end
                counter = counter + 0.05
                char.HumanoidRootPart.CFrame = CFrame.new(centerPos + Vector3.new(math.cos(counter)*25, 0, math.sin(counter)*25), centerPos)
                char.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
            else centerPos = nil end

            -- Fitur Auto Buy (Deteksi Warna Tombol Hijau)
            if Settings.AutoH then
                local pGui = p:FindFirstChild("PlayerGui")
                if pGui then
                    for _, v in pairs(pGui:GetDescendants()) do
                        if v:IsA("TextButton") and v.BackgroundColor3.G > 0.6 and v.Visible then v:Activate() end
                    end
                end
            end

            -- Fitur Combat (Aura & Nuke)
            for _, v in pairs(game.Workspace:GetDescendants()) do
                if v:IsA("Humanoid") and v.Health > 0 and not game.Players:GetPlayerFromCharacter(v.Parent) then
                    local r = v.Parent:FindFirstChild("HumanoidRootPart")
                    if r then
                        if Settings.Clear or (Settings.Aura and (char.HumanoidRootPart.Position - r.Position).Magnitude <= Settings.Range) then
                            local rem = game.ReplicatedStorage:FindFirstChild("Attack") or game.ReplicatedStorage:FindFirstChild("Hit")
                            if rem then rem:FireServer(v.Parent) end
                        end
                    end
                end
            end
        end
    end
end)
